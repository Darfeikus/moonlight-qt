[Unit]
Description=USB/IP device service for Moonlight
Requires=usbipd.service
After=usbipd.service

[Service]
Type=simple
User=root
ExecStartPre=/usr/bin/modprobe usbip_host
# @USER@ is replaced by install-usbip-service.sh with the account that runs Moonlight.
ExecStart=/usr/bin/python3 -I /usr/local/lib/usbip-bind.py serve --user @USER@
RuntimeDirectory=usbip-bind
RuntimeDirectoryMode=0755
StateDirectory=usbip-bind
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
